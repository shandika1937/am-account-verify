# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-only. Set this in the Convex dashboard (Settings → Environment Variables).
# Never prefix with VITE_ — it must not be exposed to the browser.
# Leave empty to run the mock verification adapter.
ALIGHT_MOTION_API_KEY=
